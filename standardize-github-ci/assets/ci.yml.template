name: CI

# Keep PR certification dispatch-only. Add a default-branch push trigger only when repository protection or deployment evidence requires it.
on:
  workflow_dispatch:
    inputs:
      expected_sha:
        description: Exact RAS-reviewed head SHA to certify
        required: true
        type: string
      base_sha:
        description: Optional base SHA for change classification; omission fails closed to the code lane
        required: false
        type: string

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  classify:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      docs_only: ${{ steps.changes.outputs.docs_only }}
      source_changed: ${{ steps.changes.outputs.source_changed }}
    steps:
      - name: Require the RAS-reviewed head
        if: ${{ github.event_name == 'workflow_dispatch' }}
        env:
          EXPECTED_SHA: ${{ inputs.expected_sha }}
        run: |
          test "$GITHUB_SHA" = "$EXPECTED_SHA" || {
            printf 'error: dispatched head %s does not match RAS-reviewed head %s\n' "$GITHUB_SHA" "$EXPECTED_SHA" >&2
            exit 1
          }
      # Replace action tags and tool versions with repository-approved immutable pins.
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
          persist-credentials: false
      - id: changes
        env:
          CI_BASE_SHA: ${{ github.event_name == 'workflow_dispatch' && inputs.base_sha || github.event.before }}
          CI_HEAD_SHA: ${{ github.sha }}
        run: ./scripts/classify-ci-changes.sh

  docs:
    needs: classify
    if: needs.classify.outputs.docs_only == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      # Keep this command equivalent to `task docs-check` without installing a language toolchain merely to invoke Task.
      - run: ./scripts/check-docs.sh

  code:
    needs: classify
    if: needs.classify.outputs.docs_only != 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-go@v6
        with:
          go-version-file: go.mod
          cache: true
      - run: go run github.com/go-task/task/v3/cmd/task@v3.51.1 check

  ci-required:
    name: ci-required
    if: ${{ !cancelled() }}
    needs: [classify, docs, code]
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - env:
          CLASSIFY_RESULT: ${{ needs.classify.result }}
          DOCS_ONLY: ${{ needs.classify.outputs.docs_only }}
          DOCS_RESULT: ${{ needs.docs.result }}
          CODE_RESULT: ${{ needs.code.result }}
        run: ./scripts/require-ci-results.sh

  # Add every additional required job to `ci-required.needs` and validate its result before allowing the gate to pass.
